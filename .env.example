# Copy to .env.local (Next.js) — docker compose up -d provides both services locally.
DATABASE_URL=postgres://asasline:asasline@localhost:5432/asasline
REDIS_URL=redis://localhost:6379
APP_TIMEZONE=Europe/Brussels
SESSION_HOURS=12

# Used once by `npm run db:seed` to create the first Admin (password >= 10 chars).
SEED_ADMIN_EMAIL=admin@asasline.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-now-please

# Not read from this file: set it in your shell or user environment, where the pre-push gate sees it.
# The browser suite runs on this throwaway database, never on DATABASE_URL (abatty 0.6.0 defers it
# to CI otherwise). Create it once: docker exec projectasasline-postgres-1 psql -U asasline -c "create database asasline_e2e"
# The suite's Redis is index 1 (abatty.config.json suiteEnv), apart from the dev server's cache.
# TEST_DATABASE_URL=postgres://asasline:asasline@localhost:5432/asasline_e2e

# Where the files on a booking are stored, one folder per booking (default var/files, gitignored).
# FILES_DIR=var/files
