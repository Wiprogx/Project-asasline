# Copy to .env.local (Next.js) — docker compose up -d provides both services locally.
DATABASE_URL=postgres://asasline:asasline@localhost:5432/asasline
REDIS_URL=redis://localhost:6379
APP_TIMEZONE=Europe/Brussels
SESSION_HOURS=12

# Used once by `npm run db:seed` to create the first Admin (password >= 10 chars).
SEED_ADMIN_EMAIL=admin@asasline.com
SEED_ADMIN_NAME=Admin
SEED_ADMIN_PASSWORD=change-me-now-please
